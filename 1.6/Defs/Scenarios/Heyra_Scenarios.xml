<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- [1.6 FIX] ScenarioDef must inherit ScenarioBase for map layer system (surfaceLayer etc.) -->

	<!-- ═══════════════════════════════════════════════════════════════════════
	     SCENARIO 1: New Horizons — Standard Crashlanded-equivalent start
	     3 colonists, basic Heyra gear, balanced resources
	     ═══════════════════════════════════════════════════════════════════════ -->
	<ScenarioDef ParentName="ScenarioBase">
		<defName>Heyra_Scenario_Crashlanded</defName>
		<label>Heyran Chronicle: New Horizons</label>
		<description>The homeland is far behind. Whether driven out by war, famine, or simply the restless pull of the unknown, the three of you have wandered for weeks through unfamiliar territory. The trails have grown cold and the old maps are useless here.\n\nBut the land ahead is rich — timber, stone, fertile soil. The Teller's blessing still hums faintly in your horns. With what supplies you've carried and whatever this new land offers, it's time to put down roots. A new chapter begins.</description>
		<scenario>
			<summary>Three Heyra wanderers settle in an unknown land with basic supplies. A standard starting experience.</summary>
			<playerFaction>
				<def>PlayerFaction</def>
				<factionDef>Heyra_PlayerFactionGeneral</factionDef>
			</playerFaction>
			<parts>
				<li Class="ScenPart_ConfigPage_ConfigureStartingPawns">
					<def>ConfigPage_ConfigureStartingPawns</def>
					<pawnCount>3</pawnCount>
					<pawnChoiceCount>8</pawnChoiceCount>
				</li>
				<li Class="ScenPart_PlayerPawnsArriveMethod">
					<def>PlayerPawnsArriveMethod</def>
					<method>Standing</method>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>Silver</thingDef>
					<count>800</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>Heyra_Biscuit</thingDef>
					<count>50</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>MedicineIndustrial</thingDef>
					<count>30</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>ComponentIndustrial</thingDef>
					<count>30</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>Heyra_Crossbow</thingDef>
					<count>1</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>Heyra_Crossbow</thingDef>
					<count>1</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>Heyra_Sword</thingDef>
					<stuff>Steel</stuff>
					<count>1</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>Heyra_Soldierhelmet</thingDef>
					<stuff>Steel</stuff>
					<count>1</count>
				</li>
				<li Class="ScenPart_StartingAnimal">
					<def>StartingAnimal</def>
					<count>1</count>
				</li>
				<li Class="ScenPart_ScatterThingsNearPlayerStart">
					<def>ScatterThingsNearPlayerStart</def>
					<thingDef>Steel</thingDef>
					<count>450</count>
				</li>
				<li Class="ScenPart_ScatterThingsNearPlayerStart">
					<def>ScatterThingsNearPlayerStart</def>
					<thingDef>WoodLog</thingDef>
					<count>300</count>
				</li>
			</parts>
		</scenario>
	</ScenarioDef>

	<!-- ═══════════════════════════════════════════════════════════════════════
	     SCENARIO 2: The Long March — Many colonists, scarce resources
	     6 colonists, tribal-level supplies, survival pressure
	     ═══════════════════════════════════════════════════════════════════════ -->
	<ScenarioDef ParentName="ScenarioBase">
		<defName>Heyra_Scenario_LongMarch</defName>
		<label>Heyran Chronicle: The Long March</label>
		<description>The village burned three days ago. The Rong came at dawn, and by dusk there was nothing left but ash and screaming. You gathered who you could — farmers, a healer, an old smith, anyone still standing — and fled into the hills.\n\nSix of you survived the march. Your supplies are pitiful: a handful of biscuits, some scavenged weapons, and whatever herbs the healer managed to grab. But there are six pairs of hands, and the land you've stumbled into is untouched. If you work together, you might just make it.</description>
		<scenario>
			<summary>Six Heyra refugees flee a destroyed village. Many hands, but almost nothing to work with.</summary>
			<playerFaction>
				<def>PlayerFaction</def>
				<factionDef>Heyra_PlayerFactionGeneral</factionDef>
			</playerFaction>
			<parts>
				<li Class="ScenPart_ConfigPage_ConfigureStartingPawns">
					<def>ConfigPage_ConfigureStartingPawns</def>
					<pawnCount>6</pawnCount>
					<pawnChoiceCount>12</pawnChoiceCount>
				</li>
				<li Class="ScenPart_PlayerPawnsArriveMethod">
					<def>PlayerPawnsArriveMethod</def>
					<method>Standing</method>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>Silver</thingDef>
					<count>200</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>Heyra_Biscuit</thingDef>
					<count>30</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>MedicineHerbal</thingDef>
					<count>20</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>Heyra_Crossbow</thingDef>
					<count>1</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>Heyra_Sword</thingDef>
					<stuff>Steel</stuff>
					<count>1</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>Heyra_Daggeraxe</thingDef>
					<stuff>Steel</stuff>
					<count>1</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>Heyra_Halberd</thingDef>
					<stuff>Steel</stuff>
					<count>1</count>
				</li>
				<li Class="ScenPart_ScatterThingsNearPlayerStart">
					<def>ScatterThingsNearPlayerStart</def>
					<thingDef>WoodLog</thingDef>
					<count>200</count>
				</li>
				<li Class="ScenPart_ScatterThingsAnywhere">
					<def>ScatterThingsAnywhere</def>
					<thingDef>Steel</thingDef>
					<count>150</count>
				</li>
			</parts>
		</scenario>
	</ScenarioDef>

	<!-- ═══════════════════════════════════════════════════════════════════════
	     SCENARIO 3: The Blade Unsheathed — Two elite veterans, well-equipped
	     2 colonists, soldier faction, strong gear but outnumbered
	     ═══════════════════════════════════════════════════════════════════════ -->
	<ScenarioDef ParentName="ScenarioBase">
		<defName>Heyra_Scenario_BladeUnsheathed</defName>
		<label>Heyran Chronicle: The Blade Unsheathed</label>
		<description>You were the best. Two sword-sisters of the Forbidden Army, the sharpest blades the Heyra have ever forged. But the war is over, and your side lost. The generals are dead, the banners burned, the army scattered to the winds.\n\nNow you walk as ronin — masterless, but not toothless. Your armor still gleams, your blades are still sharp, and between the two of you, there is enough skill to build an empire from nothing. The question is whether two warriors can learn to farm before their supplies run dry.</description>
		<scenario>
			<summary>Two elite Heyra veterans with excellent equipment. Highly skilled, but dangerously outnumbered.</summary>
			<playerFaction>
				<def>PlayerFaction</def>
				<factionDef>Heyra_PlayerFactionSoldier</factionDef>
			</playerFaction>
			<parts>
				<li Class="ScenPart_ConfigPage_ConfigureStartingPawns">
					<def>ConfigPage_ConfigureStartingPawns</def>
					<pawnCount>2</pawnCount>
					<pawnChoiceCount>6</pawnChoiceCount>
				</li>
				<li Class="ScenPart_PlayerPawnsArriveMethod">
					<def>PlayerPawnsArriveMethod</def>
					<method>Standing</method>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>Silver</thingDef>
					<count>500</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>Heyra_Biscuit</thingDef>
					<count>40</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>MedicineIndustrial</thingDef>
					<count>15</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>ComponentIndustrial</thingDef>
					<count>15</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>Heyra_Forbiddenarmysword</thingDef>
					<stuff>Steel</stuff>
					<count>1</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>Heyra_Forbiddenarmyhalberd</thingDef>
					<stuff>Steel</stuff>
					<count>1</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>Heyra_Forbiddenarmypanoply</thingDef>
					<stuff>Steel</stuff>
					<count>1</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>Heyra_Forbiddenarmypanoply</thingDef>
					<stuff>Steel</stuff>
					<count>1</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>Heyra_Forbiddenarmyhelmet</thingDef>
					<stuff>Steel</stuff>
					<count>1</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>Heyra_Forbiddenarmyhelmet</thingDef>
					<stuff>Steel</stuff>
					<count>1</count>
				</li>
				<li Class="ScenPart_ScatterThingsNearPlayerStart">
					<def>ScatterThingsNearPlayerStart</def>
					<thingDef>Steel</thingDef>
					<count>350</count>
				</li>
				<li Class="ScenPart_ScatterThingsNearPlayerStart">
					<def>ScatterThingsNearPlayerStart</def>
					<thingDef>WoodLog</thingDef>
					<count>250</count>
				</li>
			</parts>
		</scenario>
	</ScenarioDef>

	<!-- ═══════════════════════════════════════════════════════════════════════
	     BANDO'S TWO LOST SCENARIOS, restored 2026-10 (VEF removal phase 4b)
	     From the original Heyra the Horned (Workshop 2689852146, 1.4), words
	     and numbers as Bando wrote them. They started you inside his
	     Stronghold and Village layouts through KCSG; the revival's content
	     came from a newer base that never had them. Now built by Heyra's own
	     ScenPart_StartingStructure.
	     ═══════════════════════════════════════════════════════════════════════ -->

	<ScenPartDef>
		<defName>Heyra_AddStartingStructure</defName>
		<label>add Heyra structure to starting map</label>
		<category>Misc</category>
		<scenPartClass>Heyra.ScenPart_StartingStructure</scenPartClass>
		<maxUses>1</maxUses>
		<selectionWeight>0</selectionWeight>
	</ScenPartDef>

	<ScenPartDef>
		<defName>Heyra_GameCondition_VolcanicWinter</defName>
		<label>Volcanic winter incoming</label>
		<scenPartClass>ScenPart_GameCondition</scenPartClass>
		<category>GameCondition</category>
		<selectionWeight>0.8</selectionWeight>
		<summaryPriority>400</summaryPriority>
		<maxUses>1</maxUses>
		<gameCondition>VolcanicWinter</gameCondition>
		<gameConditionTargetsWorld>true</gameConditionTargetsWorld>
		<durationRandomRange>30~40</durationRandomRange>
	</ScenPartDef>

	<ScenarioDef ParentName="ScenarioBase">
		<defName>Heyra_Scenario_Stronghold</defName>
		<label>Heyran Chronicle: The Last Stand</label>
		<description>Continuous fights have depleted this remote Heyran stronghold. There were sixteen soldiers, and now there are only four. The south wall was blown down by Rong artillery during last month's battle, since then defending has become much harder. And to make things worse, the supply line was cut off earlier this week. Food is running short. This looks like the end of this stronghold.\n\nThe soldiers are left to survive on their own. They need to not only repulse the raiders, but also to find a sustainable way to survive. If possible, recruit some men. After all, in a situation like this, they would really appreciate some extra helping hands.</description>
		<scenario>
			<summary>Four Heyra soldiers trying to survive in a remote stronghold. Situation is grim.</summary>
			<playerFaction>
				<def>PlayerFaction</def>
				<factionDef>Heyra_PlayerFactionSoldier</factionDef>
			</playerFaction>
			<parts>
				<li Class="ScenPart_ConfigPage_ConfigureStartingPawns">
					<def>ConfigPage_ConfigureStartingPawns</def>
					<pawnCount>4</pawnCount>
					<pawnChoiceCount>10</pawnChoiceCount>
				</li>
				<li Class="ScenPart_PlayerPawnsArriveMethod">
					<def>PlayerPawnsArriveMethod</def>
					<method>Standing</method>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>Silver</thingDef>
					<count>100</count>
				</li>
				<li Class="ScenPart_ScatterThingsNearPlayerStart">
					<def>ScatterThingsNearPlayerStart</def>
					<thingDef>WoodLog</thingDef>
					<count>150</count>
				</li>
				<li Class="ScenPart_ScatterThingsAnywhere">
					<def>ScatterThingsAnywhere</def>
					<thingDef>Steel</thingDef>
					<count>220</count>
				</li>
				<li Class="ScenPart_CreateIncident">
					<def>CreateIncident</def>
					<incident>RaidEnemy</incident>
					<intervalDays>15</intervalDays>
					<repeat>True</repeat>
				</li>
				<li Class="ScenPart_ForcedHediff">
					<def>ForcedHediff</def>
					<visible>false</visible>
					<context>PlayerStarter</context>
					<chance>0.5</chance>
					<hediff>Malnutrition</hediff>
					<hideOffMap>true</hideOffMap>
					<severityRange>0.1~0.45</severityRange>
				</li>
				<li Class="Heyra.ScenPart_StartingStructure">
					<def>Heyra_AddStartingStructure</def>
					<structureLabel>A damaged stronghold</structureLabel>
					<nearMapCenter>True</nearMapCenter>
					<chooseFrom>
						<li>Heyra_Structure_Stronghold</li>
					</chooseFrom>
				</li>
			</parts>
		</scenario>
	</ScenarioDef>

	<ScenarioDef ParentName="ScenarioBase">
		<defName>Heyra_Scenario_Village</defName>
		<label>Heyran Chronicle: Winter is Coming</label>
		<description>The Geomancer has given a prophecy, and it was a bad one. A distant volcano is going to erupt, and the ash will cast the darkest shadow on this village. Disputes broke out among the villagers, half of them decided to leave. In the chaos, a few thugs looted the village hall and escaped. There were not much left to you.</description>
		<scenario>
			<summary>Five Heyra villagers are determined to face the upcoming volcanic winter. Can they do it with very limited resources?</summary>
			<playerFaction>
				<def>PlayerFaction</def>
				<factionDef>Heyra_PlayerFactionGeneral</factionDef>
			</playerFaction>
			<parts>
				<li Class="ScenPart_ConfigPage_ConfigureStartingPawns">
					<def>ConfigPage_ConfigureStartingPawns</def>
					<pawnCount>5</pawnCount>
					<pawnChoiceCount>10</pawnChoiceCount>
				</li>
				<li Class="ScenPart_PlayerPawnsArriveMethod">
					<def>PlayerPawnsArriveMethod</def>
					<method>Standing</method>
				</li>
				<li Class="ScenPart_ScatterThingsNearPlayerStart">
					<def>ScatterThingsNearPlayerStart</def>
					<thingDef>WoodLog</thingDef>
					<count>250</count>
				</li>
				<li Class="ScenPart_ScatterThingsAnywhere">
					<def>ScatterThingsAnywhere</def>
					<thingDef>Steel</thingDef>
					<count>120</count>
				</li>
				<li Class="ScenPart_GameCondition">
					<def>Heyra_GameCondition_VolcanicWinter</def>
					<durationDays>15</durationDays>
				</li>
				<li Class="Heyra.ScenPart_StartingStructure">
					<def>Heyra_AddStartingStructure</def>
					<structureLabel>A small village</structureLabel>
					<nearMapCenter>True</nearMapCenter>
					<chooseFrom>
						<li>Heyra_Structure_Village</li>
					</chooseFrom>
				</li>
			</parts>
		</scenario>
	</ScenarioDef>

</Defs>